# All settings are optional; prefix is RAG_
RAG_DENSE_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_DENSE_DIM=384
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# RAG_HF_TOKEN=hf_...   # only needed for gated HF models
RAG_RERANK_ENABLED=true
RAG_PREFETCH_LIMIT=20
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# unstructured partition strategy: auto | hi_res | fast | ocr_only
RAG_UNSTRUCTURED_STRATEGY=auto
RAG_EXTRACT_IMAGES=true
RAG_COLLECTION_NAME=document_chunks
RAG_UPLOAD_DIR=./uploads
RAG_MAX_UPLOAD_FILES=20
RAG_QDRANT_URL=http://localhost:6333
# RAG_QDRANT_API_KEY=   # only needed if Qdrant is started with QDRANT__SERVICE__API_KEY set

# Rate limiting: local (in-process, default) or redis (shared across replicas)
RAG_REDIS_RATE_LIMIT=false
RAG_REDIS_URL=redis://localhost:6379/0
RAG_RATE_LIMIT_REQUESTS=60
RAG_RATE_LIMIT_WINDOW_SECONDS=60
RAG_IMAGE_EXTRACT_DIR=./extracted_images

# Database (SQLAlchemy, schema managed by Alembic — run `alembic upgrade head`).
# development = local SQLite file below; production = Postgres built from the
# db_* creds; RAG_DATABASE_URL, if set, overrides both.
RAG_ENVIRONMENT=development
RAG_DB_PATH=./rag.db
# RAG_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# RAG_DB_HOST=localhost
# RAG_DB_PORT=5432
# RAG_DB_NAME=rag_platform
# RAG_DB_USER=postgres
# RAG_DB_PASSWORD=
